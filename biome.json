{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 4194304,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/playground-dist",
      "!!**/public",
      "!!**/.wrangler",
      "!!**/.output",
      "!!**/.pnpm-store",
      "!!**/routeTree.gen.ts",
      "!!**/tiles-data.json",
      "!!**/assets",
      "!!**/deprecated",
      "!!**/*.css",
      "!!**/*.md",
      "!!**/.agents",
      "!!**/.claude",
      "!!**/tasks"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSameLine": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "warn"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**", "**/preprocess/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "tailwind": {
    "attributes": ["className", "class"],
    "mergeFunctions": ["cn", "clsx", "cx"],
    "variantFunctions": ["cva"],
    "stylesheet": "./src/styles/globals.css"
  }
}
