# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.npm/
package-lock.json
yarn.lock
bun.lock
bun.lockb
/*.tgz

# Build output and generated caches
/dist/
/dist-ssr/
/playground-dist/
.cache/
.tanstack/
.wrangler/
.vite/
*.tsbuildinfo
vite.config.*.timestamp-*
__pycache__/
*.py[cod]

# Local environment and credentials (examples may be committed)
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx

# Logs, diagnostics and coverage
logs/
*.log
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
coverage/
.nyc_output/
*.lcov

# OS, editor and agent-local files; shared .vscode settings stay tracked
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode-test/
.history/
/.agents/
/.claude/
/.codex/
/tasks/
/skills-lock.json
